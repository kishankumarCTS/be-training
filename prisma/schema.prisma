generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  username  String
  password  String
  createdAt DateTime @default(now())

  posts    Post[]
  comments Comment[]
  refreshToken RefreshToken[]
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String
  createdAt DateTime @default(now())

  user_id Int
  user    User @relation(fields: [user_id], references: [id])

  comments Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String
  createdAt DateTime @default(now())

  userId Int
  postId Int

  user User @relation(fields: [userId], references: [id])
  post Post @relation(fields: [postId], references: [id])
}


model RefreshToken {
  id                 Int      @id @default(autoincrement())
  user_id            Int
  user               User @relation(fields: [user_id], references: [id])

  refreshToken       String
  sessionId          String

  expireAt           DateTime
  createdAt          DateTime @default(now())
  revokedAt          DateTime?
}

